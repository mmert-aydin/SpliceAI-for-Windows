__pycache__/
*.pyc
.venv/
build/
dist/

# Downloaded at runtime next to the app, not project code
snpeff/
mane/
java/
*.fa
*.fa.fai
*.fa.gz

# Installer build: third-party payload (large, re-fetchable -- see
# installer/fetch-thirdparty.ps1), intermediate files and the built Setup.exe
installer/thirdparty/
installer/build/
installer/output/
installer/test/results/
tests/.cache/

# Variant files and result tables can hold patient data: none are committed,
# except the public demo and test VCFs below.
*.vcf
*.vcf.gz
*.bgz
*.tsv
*.csv
*.xlsx
!examples/*.vcf
!installer/test/data/*.vcf
